# Copy this file to .env and fill in real values before running the server.
# .env is gitignored — never commit your real secrets.

# Port the Node backend listens on (cPanel/Passenger usually sets this for you)
PORT=3000

# Signs customer/admin login tokens. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-before-launch

# Backend admin password — required to log in to admin.html and to call any
# admin-only API route (product writes, order list, status updates, Excel import/export).
ADMIN_PASSWORD=change-me-before-launch

# Where the SQLite database file is stored. Leave unset to default to
# backend/azizo.db — only change this if your host requires a specific writable path.
# DB_PATH=/home/youruser/azizo.db

# M-Pesa Daraja credentials (leave blank until you have real sandbox/production
# credentials from Safaricom — the site works fully without these; customers
# can still pay by cash/till and checkout via WhatsApp).
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=

# Staff password — lets counter/kitchen/dispatch staff sign in to staff.html to see and work
# orders, mark items sold out, and see today's totals. They never get the admin tool.
# Leave blank to keep staff login switched off. Use something different from ADMIN_PASSWORD.
STAFF_PASSWORD=
# Hours ahead of UTC used for "today" in the staff totals (Nairobi = 3).
TZ_OFFSET_HOURS=3
